<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Dakuten Mode</title>
  <link href="https://fonts.googleapis.com/css2?family=Klee+One&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Klee One', sans-serif;
      background-color: #fff8dc;
      text-align: center;
      padding: 20px;
    }

    .card {
      width: 140px;
      height: 140px;
      background-color: #ffb6c1;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      border-radius: 10px;
      cursor: pointer;
    }

    #gameBoard {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 15px;
      justify-items: center;
      margin-top: 20px;
    }
  </style>
</head>
<body>
  <h1>濁音・半濁音 モード</h1>
  <div id="gameBoard"></div>

  <script>
    const dakutenPairs = [
      ["が", "ga"], ["ぎ", "gi"], ["ぐ", "gu"], ["げ", "ge"], ["ご", "go"],
      ["ざ", "za"], ["じ", "ji"], ["ず", "zu"], ["ぜ", "ze"], ["ぞ", "zo"],
      ["だ", "da"], ["ぢ", "ji"], ["づ", "zu"], ["で", "de"], ["ど", "do"],
      ["ば", "ba"], ["び", "bi"], ["ぶ", "bu"], ["べ", "be"], ["ぼ", "bo"],
      ["ぱ", "pa"], ["ぴ", "pi"], ["ぷ", "pu"], ["ぺ", "pe"], ["ぽ", "po"]
    ];

    const cards = dakutenPairs.flatMap(pair => [
      { text: pair[0], id: pair[1] },
      { text: pair[1], id: pair[1] }
    ]);

    let selected = [];
    let matched = [];

    function shuffle(array) {
      return array.sort(() => Math.random() - 0.5);
    }

    function renderBoard() {
      const board = document.getElementById("gameBoard");
      const shuffled = shuffle([...cards]);
      shuffled.forEach(card => {
        const div = document.createElement("div");
        div.className = "card";
        div.dataset.id = card.id;
        div.textContent = "？";
        div.addEventListener("click", () => flipCard(div, card.text));
        board.appendChild(div);
      });
    }

    function flipCard(cardElement, actualText) {
      if (cardElement.classList.contains("matched") || selected.length === 2 || selected.includes(cardElement)) return;

      cardElement.textContent = actualText;
      selected.push(cardElement);

      if (selected.length === 2) {
        const [card1, card2] = selected;
        if (card1.dataset.id === card2.dataset.id) {
          card1.classList.add("matched");
          card2.classList.add("matched");
          matched.push(card1.dataset.id);
        } else {
          setTimeout(() => {
            card1.textContent = "？";
            card2.textContent = "？";
          }, 800);
        }
        selected = [];
      }
    }

    renderBoard();
  </script>
</body>
</html>
